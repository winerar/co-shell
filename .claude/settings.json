{
  "model": "opusplan",
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "8000",
    "MAX_MCP_OUTPUT_TOKENS": "12000"
  },
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(scripts/agent/check.sh:*)",
      "Bash(scripts/agent/session-start.sh:*)",
      "Bash(scripts/agent/session-end.sh:*)",
      "Bash(scripts/agent/sync-dev.sh:*)",
      "Bash(scripts/agent/build-summary.sh:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git show:*)",
      "Bash(git grep:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git checkout:*)",
      "Bash(scripts/agent/agent.sh:*)",
      "Bash(git push:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)"
    ],
    "deny": [
      "Read(./build/**)",
      "Read(./**/build/**)",
      "Read(./docs/design/mockups/**)",
      "Read(./**/*.png)",
      "Read(./.gradle/**)",
      "Read(./gradle/wrapper/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/agent/hook-session-start.sh",
            "timeout": 90
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/agent/hook-edit-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/agent/hook-stop.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
