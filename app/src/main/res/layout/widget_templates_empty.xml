<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_card_edge" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_shape_card" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/w_card_fill" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="1dp" android:src="@drawable/widget_shape_card" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="16dp">
        <TextView android:id="@+id/e_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="2" android:textSize="14sp" />
        <FrameLayout android:id="@+id/e_create" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="12dp" android:foreground="@drawable/widget_press">
            <ImageView android:id="@+id/e_fill" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_shape_pill" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:orientation="horizontal" android:paddingHorizontal="18dp">
                <ImageView android:id="@+id/e_icon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_widget_plus" android:importantForAccessibility="no" />
                <TextView android:id="@+id/e_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:textSize="15sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
