<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_card_edge" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_shape_card" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/w_card_fill" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="1dp" android:src="@drawable/widget_shape_card" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingHorizontal="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/w_lock_icon" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_widget_lock" android:importantForAccessibility="no" />
            <TextView android:id="@+id/w_lock_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
            <FrameLayout android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1">
                <ImageView android:id="@+id/w_expense_fill" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_shape_pill" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="horizontal">
                    <ImageView android:id="@+id/w_expense_icon" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_widget_out" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/w_expense_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:maxLines="1" android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="10dp" android:layout_weight="1">
                <ImageView android:id="@+id/w_income_fill" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_shape_pill" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="horizontal">
                    <ImageView android:id="@+id/w_income_icon" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_widget_in" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/w_income_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:maxLines="1" android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
