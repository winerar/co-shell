<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_card_edge" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_shape_card" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/w_card_fill" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="1dp" android:src="@drawable/widget_shape_card" android:scaleType="fitXY" android:importantForAccessibility="no" />
