rules_version = '2';

// Firestore security rules for co-shell. Paste into Firebase console → Firestore → Rules
// (docs/setup/sync.md). Everything not listed here is denied.
// Tests: scripts/test-rules.sh (emulator, firebase/rules-test/).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function familyDoc(fid) {
      return get(/databases/$(database)/documents/families/$(fid));
    }

    function isMember(fid) {
      return signedIn() && exists(/databases/$(database)/documents/families/$(fid))
             && request.auth.uid in familyDoc(fid).data.memberUids;
    }

    // Verified Google email of the caller, lower-case — the id of their invitation.
    function myEmail() {
      return request.auth.token.email.lower();
    }

    function hasVerifiedEmail() {
      return signedIn() && request.auth.token.email != null && request.auth.token.email_verified == true;
    }

    function isInvited(fid) {
      return hasVerifiedEmail()
             && exists(/databases/$(database)/documents/invites/$(myEmail()))
             && get(/databases/$(database)/documents/invites/$(myEmail())).data.familyId == fid;
    }

    // Who disappears from memberUids in this update (used by the leave/remove rule).
    function removedUids() {
      return resource.data.memberUids.toSet().difference(request.resource.data.memberUids.toSet());
    }

    function memberEntry(m) {
      return m.keys().hasOnly(['name', 'email']) && m.name is string && m.name.size() <= 100
             && m.email is string && m.email.size() <= 200;
    }

    // Families: each has its own random id (>= 20 chars, FamilyRemote.newFamilyId); the first family of the
    // project keeps the id `main` (the owner's own, created before families became many). Whoever creates a
    // family is its owner; others get in only by invitation (issue #34), at most MAX_MEMBERS = 10 (#661).
    // The pointer `users/{uid}` says which family a person is in (written atomically with create/join).
    match /families/{fid} {
      allow read: if (signedIn() && request.auth.uid in resource.data.memberUids) || isInvited(fid);

      allow create: if (fid == 'main' || fid.size() >= 20) && signedIn()
                    && request.resource.data.keys().hasOnly(['ownerUid', 'memberUids', 'members', 'createdAt'])
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.memberUids == [request.auth.uid]
                    && request.resource.data.members.keys().hasOnly([request.auth.uid])
                    && memberEntry(request.resource.data.members[request.auth.uid])
                    && request.resource.data.createdAt == request.time;

      // Joining: an invited user adds only themselves; the family holds at most 10 people.
      allow update: if isInvited(fid)
                    && !(request.auth.uid in resource.data.memberUids)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members'])
                    && request.resource.data.memberUids.toSet() == resource.data.memberUids.toSet().union([request.auth.uid].toSet())
                    && request.resource.data.memberUids.size() <= 10
                    && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
                    && memberEntry(request.resource.data.members[request.auth.uid]);

      // Leaving (a member removes themselves; the owner cannot leave — they delete the family) and
      // removal (only the owner removes someone else, never themselves): exactly one person goes.
      allow update: if signedIn() && request.auth.uid in resource.data.memberUids
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members'])
                    && removedUids().size() == 1
                    && request.resource.data.memberUids.toSet().difference(resource.data.memberUids.toSet()).size() == 0
                    && request.resource.data.members.diff(resource.data.members).affectedKeys() == removedUids()
                    && (removedUids() == [request.auth.uid].toSet() && request.auth.uid != resource.data.ownerUid
                        || request.auth.uid == resource.data.ownerUid && !removedUids().hasAny([resource.data.ownerUid]));

      // Deleting the family: only the owner (its records and invitations go first, see below).
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerUid;

      // Budget data: one document per row (FirestoreRemoteStore). Rows are never deleted —
      // deletion is a tombstone (`deleted: true`), so the other phone learns about it.
      match /records/{key} {
        allow read: if isMember(fid);
        allow create, update: if isMember(fid)
                    && request.resource.data.keys().hasOnly(['kind', 'id', 'updatedAt', 'updatedBy', 'deleted', 'json', 'serverUpdatedAt'])
                    && request.resource.data.kind in ['account', 'category', 'transaction', 'budget', 'manualRate', 'template', 'setting', 'tag']
                    && request.resource.data.id is string
                    && key == request.resource.data.kind + '_' + request.resource.data.id
                    && request.resource.data.updatedAt is int
                    && (request.resource.data.updatedBy == null || request.resource.data.updatedBy == request.auth.uid)
                    && request.resource.data.deleted is bool
                    && request.resource.data.json is string && request.resource.data.json.size() <= 100000
                    && request.resource.data.serverUpdatedAt == request.time;
        // Rows are tombstones while the family lives; only the owner wipes them when deleting the family (#653).
        allow delete: if signedIn() && exists(/databases/$(database)/documents/families/$(fid))
                    && request.auth.uid == familyDoc(fid).data.ownerUid;
      }
    }

    // Pointer «which family am I in» — one per person; written together with the family (create/join),
    // so it never names a family the person is not in. Removed from the family, the person's pointer stays:
    // that is how their phone learns it was removed (and not just never invited).
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['familyId', 'updatedAt'])
                    && request.resource.data.familyId is string && request.resource.data.familyId.size() <= 64
                    && request.resource.data.updatedAt == request.time
                    && request.auth.uid in getAfter(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.memberUids;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Invitations by Google email (document id = lower-case email).
    match /invites/{email} {
      allow get: if (hasVerifiedEmail() && email == myEmail()) || isMember(resource.data.familyId);
      allow list: if isMember(resource.data.familyId);
      allow create, update: if isMember(request.resource.data.familyId)
                    && request.resource.data.keys().hasOnly(['familyId', 'invitedBy', 'createdAt'])
                    && request.resource.data.invitedBy == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && email == email.lower()
                    && (resource == null || isMember(resource.data.familyId));
      allow delete: if isMember(resource.data.familyId) || (hasVerifiedEmail() && email == myEmail());
    }

    // Feedback form: the app (no sign-in) may only CREATE a well-formed message and GET one by its
    // random id (the phone keeps the ids of its own messages and shows their status, #157).
    // Nobody can list, change or delete them from the app; the GitHub Action reads them with a
    // service account (bypasses rules), turns them into issues and writes the issue status back.
    // Fields and limits must match app/.../feedback/data/FeedbackDocument.kt and SendFeedbackUseCase.
    match /feedback/{id} {
      allow get: if true;
      allow create: if request.resource.data.keys().hasOnly(
                         ['text', 'createdAt', 'appVersion', 'versionCode', 'device', 'os', 'installationId', 'processed', 'attachments'])
                    && (!('attachments' in request.resource.data)
                        || (request.resource.data.attachments is list && request.resource.data.attachments.size() <= 12))
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 4000
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.appVersion is string && request.resource.data.appVersion.size() <= 50
                    && request.resource.data.versionCode is int
                    && request.resource.data.device is string && request.resource.data.device.size() <= 200
                    && request.resource.data.os is string && request.resource.data.os.size() <= 100
                    && request.resource.data.installationId is string && request.resource.data.installationId.size() <= 64
                    && request.resource.data.processed == false;
    }

    // Files of a feedback message (FeedbackAttachment): base64 parts, created by anyone, read only by the robot
    // (service account). Limits must match FeedbackAttachment and app/.../feedback/data/FeedbackDocument.kt.
    match /feedback_files/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'mime', 'file', 'part', 'parts', 'data', 'createdAt'])
                    && request.resource.data.name is string && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.mime is string && request.resource.data.mime.size() <= 100
                    && request.resource.data.file is int && request.resource.data.file >= 0 && request.resource.data.file < 3
                    && request.resource.data.parts is int && request.resource.data.parts > 0 && request.resource.data.parts <= 8
                    && request.resource.data.part is int && request.resource.data.part >= 0
                    && request.resource.data.part < request.resource.data.parts
                    && request.resource.data.data is string && request.resource.data.data.size() <= 700000
                    && request.resource.data.createdAt is timestamp;
    }
  }
}
