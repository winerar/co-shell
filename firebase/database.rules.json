{
  "rules": {
    "families": {
      "$familyId": {
        "members": {
          ".read": "auth != null && data.child(auth.uid).val() === true",
          "$uid": {
            ".write": "auth != null && auth.token.email_verified === true && (data.parent().child(auth.uid).val() === true || (!data.parent().exists() && $uid === auth.uid))",
            ".validate": "newData.val() === true"
          }
        },
        "ping": {
          ".read": "auth != null && root.child('families').child($familyId).child('members').child(auth.uid).val() === true",
          ".write": "auth != null && root.child('families').child($familyId).child('members').child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['at', 'by'])",
          "at": { ".validate": "newData.val() === now" },
          "by": { ".validate": "newData.val() === auth.uid" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
