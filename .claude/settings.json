{
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "12000",
    "MAX_MCP_OUTPUT_TOKENS": "12000"
  },
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(scripts/agent/check.sh:*)",
      "Bash(scripts/agent/session-start.sh:*)",
      "Bash(scripts/agent/session-end.sh:*)",
      "Bash(scripts/agent/sync-dev.sh:*)",
      "Bash(scripts/agent/build-summary.sh:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git show:*)",
      "Bash(git grep:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git checkout:*)"
    ]
  }
}
