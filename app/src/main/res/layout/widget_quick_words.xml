<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_card_edge" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_shape_card" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/w_card_fill" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="1dp" android:src="@drawable/widget_shape_card" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="16dp">
        <FrameLayout android:id="@+id/w_expense" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:foreground="@drawable/widget_press">
            <ImageView android:id="@+id/w_expense_edge" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_shape_pill" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/w_expense_fill" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="2dp" android:src="@drawable/widget_shape_pill" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="horizontal">
                <ImageView android:id="@+id/w_expense_icon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_widget_out" android:importantForAccessibility="no" />
                <TextView android:id="@+id/w_expense_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/w_income" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="10dp" android:layout_weight="1" android:foreground="@drawable/widget_press">
            <ImageView android:id="@+id/w_income_fill" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_shape_pill" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="horizontal">
                <ImageView android:id="@+id/w_income_icon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_widget_in" android:importantForAccessibility="no" />
                <TextView android:id="@+id/w_income_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:textSize="15sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
