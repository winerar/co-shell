<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="co-shell AI bench"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- Without these the «GPU» checkbox cannot work: LiteRT-LM's GPU backend loads OpenCL from the system. -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <provider
            android:name=".AnswersProvider"
            android:authorities="app.coshell.aibench.answers"
            android:exported="false"
            android:grantUriPermissions="true" />
        <activity android:name=".MainActivity" android:exported="true" android:configChanges="orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
